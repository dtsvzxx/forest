# The Windows launcher is read by cmd.exe, which needs CRLF; everything else is LF.
*.bat text eol=crlf
gradlew text eol=lf

# The icons are generated binaries — never touch their bytes, or the staleness
# check in IconAssetsTest starts failing on whoever checked them out.
*.png binary
*.ico binary
*.icns binary
*.jar binary

# The recorded terminal streams are bytes, not text.
#
# They carry the carriage returns a real program emitted, and the goldens beside them were made
# from those exact bytes. Normalising the line endings would rewrite the recordings on checkout
# and every golden test would fail on the next machine — a confusing way to find out that a
# fixture is not a text file.
terminal/src/jvmTest/resources/term/*.raw binary
